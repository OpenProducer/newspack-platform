{
	"name": "stellarwp/banners",
	"description": "Marketing banners for WordPress admin pages, dismissed per user across every plugin that bundles them.",
	"type": "library",
	"license": "MIT",
	"authors": [
		{
			"name": "StellarWP",
			"email": "dev@stellarwp.com"
		},
		{
			"name": "Dimi",
			"email": "dimi@nexcess.com"
		}
	],
	"require": {
		"php": "^7.4 || ^8.0"
	},
	"require-dev": {
		"brain/monkey": "^2.6",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.2",
		"phpunit/phpunit": "^9.5",
		"squizlabs/php_codesniffer": "^3.9",
		"stellarwp/nexcess-coding-standards": "^2.0",
		"szepeviktor/phpstan-wordpress": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"Nexcess\\Banners\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Nexcess\\Banners\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"phpstan": "phpstan analyse --memory-limit=512M",
		"phpcs": "phpcs",
		"phpcbf": "phpcbf",
		"check": [
			"@phpcs",
			"@phpstan",
			"@test"
		]
	},
	"config": {
		"sort-packages": true,
		"platform": {
			"php": "7.4.33"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	},
	"minimum-stability": "stable"
}
